{
    "require": {
        "endroid/qr-code": "^6.0",
        "php": ">=8.4",
        "ext-gd": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "name": "mwakaambrose/qrcode-wizard",
    "description": "SOLID QR batch generation with PHP and CLI APIs",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "QRCodeWizard\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --debug --no-progress",
        "audit:dependencies": "composer audit --locked"
    }
}
